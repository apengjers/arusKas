    <queryString language="SQL">
        <![CDATA[
SELECT id, tanggal, jenis, kategori, keterangan, nominal
FROM transaksi
ORDER BY tanggal DESC, id DESC
        ]]>
    </queryString>
    <field name="id" class="java.lang.Long"/>
    <field name="tanggal" class="java.sql.Date"/>
    <field name="jenis" class="java.lang.String"/>
    <field name="kategori" class="java.lang.String"/>
    <field name="keterangan" class="java.lang.String"/>
    <field name="nominal" class="java.math.BigDecimal"/>
    <variable name="totalPemasukan" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA["PEMASUKAN".equals($F{jenis}) ? $F{nominal} : java.math.BigDecimal.ZERO]]></variableExpression>
    </variable>
    <variable name="totalPengeluaran" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA["PENGELUARAN".equals($F{jenis}) ? $F{nominal} : java.math.BigDecimal.ZERO]]></variableExpression>
    </variable>
